; QD16 / 1 MiB fio ceilings for the checkpoint writer: io_uring, O_DIRECT, fixed buffers,
; fallocate, 8 GiB. Write job first, then read job (stonewall), same file.
; The file comes from the FIO_FILE environment variable (fio has no ${VAR:-default}, so the
; /mnt/nvme/fio.tmp default lives in tools/fio/run_ceiling.sh, which also captures df and env.json).
; By hand:  FIO_FILE=/mnt/nvme/fio.tmp fio tools/fio/ceiling_qd16.fio
[global]
ioengine=io_uring
direct=1
bs=1M
iodepth=16
fixedbufs=1
fallocate=native
size=8G
filename=${FIO_FILE}
log_avg_msec=1000

[write]
rw=write
write_bw_log=write

[read]
stonewall
rw=read
; fio has no read_bw_log; write_bw_log logs bandwidth for reads too (-> read_bw.1.log)
write_bw_log=read
